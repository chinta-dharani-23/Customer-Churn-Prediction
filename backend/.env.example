# Copy this file to `.env` (same folder) and edit. Never commit `.env`.

# --- Database -----------------------------------------------------------
# Leave EMPTY to use a local SQLite file (backend/churn.db): zero setup.
# For Neon, paste the connection string from the Neon dashboard as-is:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- CORS: the frontend address(es) allowed to call this API ------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI plain-language explanation (optional) ---------------------------
# Without a key, only the "Explain in plain language" button is disabled (503).
# Get a Gemini key from https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
NARRATIVE_RATE_LIMIT=10
