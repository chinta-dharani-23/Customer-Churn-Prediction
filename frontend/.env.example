# Copy to .env and adjust. Only variables prefixed with VITE_ reach the browser.
VITE_APP_NAME=Churn Insight
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT_MS=15000
# "true" = demo mode (labeled sample data, no backend needed). "false" = call the real API; failures show a connection error, never fake data.
VITE_USE_MOCKS=true
